# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql+psycopg://dev:dev@localhost:5432/greenroom
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=dev
S3_SECRET_KEY=devdevdev
S3_BUCKET=greenroom

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

OPENAI_API_KEY=

# Named per job, not per provider — these change often during phase 8.
MODEL_CONVERSATION=
MODEL_ROUTER=
MODEL_SCORER=
MODEL_REPORT=

# replay | record | off
CASSETTE_MODE=off

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
