# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql+psycopg://dev:dev@localhost:5432/greenroom
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=dev
S3_SECRET_KEY=devdevdev
S3_BUCKET=greenroom

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

OPENAI_API_KEY=

# Speech. OpenAI for now; phase 2 measures against the 800 ms gate and decides
# whether Deepgram (STT) or Cartesia (TTS) are needed for first-chunk latency.
#   STT_PROVIDER: openai | deepgram      TTS_PROVIDER: openai | cartesia
# Models are pinned to the cheap ones on purpose — see greenroom/config.py for
# what each alternative costs before changing them.
STT_PROVIDER=openai
TTS_PROVIDER=openai
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=ash
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Named per job, not per provider — these change often during phase 8.
MODEL_CONVERSATION=
MODEL_ROUTER=
MODEL_SCORER=
MODEL_REPORT=

# replay | record | off
CASSETTE_MODE=off

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
